# Copy to .env. Only EXPO_PUBLIC_* values belong here — everything in this file
# is compiled into the app bundle and is readable by anyone who downloads it.
#
# NEVER put an OpenAI key or a RevenueCat *secret* (sk_) key here. Those live
# only as Cloudflare Worker secrets; see cloudflare/wordping-api/.dev.vars.example.

# RevenueCat public SDK key for iOS. Safe to ship; it cannot read or grant
# entitlements on its own.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_REPLACE_ME

# Base URL of the WordPing AI proxy (cloudflare/wordping-api).
#   local:      http://127.0.0.1:8787
#   production: https://wordping-api.<your-subdomain>.workers.dev
EXPO_PUBLIC_WORDPING_API_BASE_URL=https://wordping-api.example.workers.dev
