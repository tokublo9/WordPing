{
  "name": "wordping",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:audio": "node --test tests/audioTiming.test.cjs",
    "test:cards": "node --test tests/cardSorting.test.cjs",
    "test:bulk": "node --test tests/bulkImport.test.cjs",
    "test:source": "node --test tests/",
    "pretest:unit": "tsc -p tsconfig.test.json",
    "test:unit": "node --test .test-build/tests/unit/",
    "test:worker": "npm --prefix cloudflare/wordping-api test",
    "preflight": "node scripts/releasePreflight.cjs",
    "test": "npm run test:source && npm run test:unit && npm run test:worker",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && npm --prefix cloudflare/wordping-api run typecheck",
    "validate": "npm run typecheck && npm test && npx expo export --platform ios --platform android --output-dir /tmp/wordping-dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^10.4.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.10",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
